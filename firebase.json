{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(js|json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "ca-global-leave-portal",
          "appId": "1:892173139237:android:eb904cf032ad8a9bb96ecc",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "ca-global-leave-portal",
          "configurations": {
            "android": "1:892173139237:android:eb904cf032ad8a9bb96ecc",
            "web": "1:892173139237:web:67d54f42812ea78bb96ecc",
            "windows": "1:892173139237:web:426653a115dc0264b96ecc"
          }
        }
      }
    }
  }
}
